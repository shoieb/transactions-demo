{
  "name": "flowbite-angular-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve demo --host 127.0.0.1 --port 4200 --poll 1000",
    "build": "ng build demo",
    "build:ui": "ng build demo-ui",
    "storybook": "ng run demo:storybook --host 127.0.0.1 --port 6006 --no-open",
    "build:storybook": "ng run demo:build-storybook",
    "test:e2e": "playwright test",
    "test:visual": "playwright test visual.spec.ts",
    "test:visual:update": "playwright test visual.spec.ts --update-snapshots=all",
    "demo:visual-diff": "node scripts/visual-diff.mjs",
    "report": "playwright show-report reports/playwright",
    "test:stories": "playwright test --config playwright.stories.config.ts"
  },
  "dependencies": {
    "@angular/core": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-browser-dynamic": "20.3.34",
    "@angular/animations": "20.3.34",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1",
    "@fontsource/inter": "5.2.8"
  },
  "devDependencies": {
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.34",
    "@angular/build": "20.3.34",
    "@angular-devkit/build-angular": "20.3.34",
    "ng-packagr": "20.3.2",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0",
    "@storybook/angular": "9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "storybook": "9.1.20",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.11.1",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "postcss": "8.5.6",
    "http-server": "14.1.1",
    "webpack": "5.105.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "webpack": "5.105.0"
  }
}
